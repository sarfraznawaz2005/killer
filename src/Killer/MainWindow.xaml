<Window x:Class="Killer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Killer" Height="640" Width="580" MinHeight="520" MinWidth="480"
        WindowStartupLocation="CenterScreen" Icon="Assets/killer.ico">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,10">
            <TextBlock Text="Killer" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Close a list of apps in one click, from your tray." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Kill card -->
        <Border Grid.Row="1" Margin="24,0,24,14" Padding="18" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Kill Now" Style="{StaticResource DangerButton}" Width="150" Height="46" FontSize="16" Click="KillNowButton_Click"/>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Ready." FontSize="13"/>
                    <TextBlock x:Name="HotkeyHintText" Text="Hotkey: Ctrl+Shift+K" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Margin="24,0,24,10" Background="Transparent" BorderThickness="0">
            <TabItem Header="Processes">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewProcessNameBox" Grid.Column="0" Margin="0,0,8,0"
                                 ToolTip="Example: notepad.exe" KeyDown="NewProcessNameBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Add" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="AddProcessButton_Click"/>
                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource FlatButton}" Click="BrowseProcessButton_Click"/>
                    </Grid>

                    <ListView x:Name="ProcessListView" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="On" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Process name" Width="330" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Style="{StaticResource FlatButton}" Padding="8,4" Click="RemoveProcessButton_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Import..." Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="ImportButton_Click"/>
                        <Button Content="Export..." Style="{StaticResource FlatButton}" Click="ExportButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="4,16,4,0">
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Margin="0,0,0,14"/>

                    <CheckBox x:Name="HotkeyEnabledCheck" Content="Enable global hotkey" Margin="0,0,0,8"/>
                    <DockPanel Margin="24,0,0,14">
                        <TextBlock Text="Hotkey:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="HotkeyBox" Width="180" HorizontalAlignment="Left" IsReadOnly="True"
                                 Text="Ctrl+Shift+K" ToolTip="Click here, then press the new key combination."
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    </DockPanel>

                    <CheckBox x:Name="ShowNotificationCheck" Content="Show a notification when a kill finishes" Margin="0,0,0,14"/>

                    <CheckBox x:Name="AutoKillEnabledCheck" Content="Auto-kill on a timer" Margin="0,0,0,8"/>
                    <DockPanel Margin="24,0,0,14">
                        <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="AutoKillHoursBox" Width="60" HorizontalAlignment="Left" Text="1"/>
                        <TextBlock Text="hour(s)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>

                    <TextBlock Text="Settings are stored at %AppData%\Killer\settings.json" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="16,12" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="SaveHintText" DockPanel.Dock="Left" Text="" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Save Settings" Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" Click="SaveSettingsButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
